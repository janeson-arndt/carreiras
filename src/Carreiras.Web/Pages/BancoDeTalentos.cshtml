@page "/banco-de-talentos"
@model Carreiras.Web.Pages.BancoDeTalentosModel
@{
    ViewData["Title"] = "Banco de talentos";
}
@section Head {
    <meta name="robots" content="noindex" />
    <script src="~/js/candidatar.js" asp-append-version="true" defer></script>
}
<div class="faixa faixa-curta">
    <div class="wrap">
        <p class="migalha"><a asp-page="/Vagas/Index">&larr; Ver vagas abertas</a></p>
        <h1>Banco de talentos</h1>
        <p class="vaga-nome">Deixe seu currículo sem escolher uma vaga. Avisamos quando surgir uma oportunidade para o seu perfil.</p>
    </div>
</div>

<partial name="_FormCandidatura" model="Model" />
