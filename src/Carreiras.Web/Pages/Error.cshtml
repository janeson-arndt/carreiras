@page
@model ErrorModel
@{
    ViewData["Title"] = "Algo deu errado";
}
<div class="wrap nao-encontrada">
    <h1>Algo deu errado</h1>
    <p>Não foi possível concluir o que você pediu. Tente de novo em alguns instantes.</p>
    @if (Model.ShowRequestId)
    {
        <p class="ajuda">Código para informar ao suporte: <code>@Model.RequestId</code></p>
    }
    <p><a class="btn btn-primary" asp-page="/Index">Voltar ao início</a></p>
</div>
