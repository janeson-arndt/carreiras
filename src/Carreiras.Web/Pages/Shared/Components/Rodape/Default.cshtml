@model Carreiras.Web.ViewComponents.RodapeModelo
<footer class="rodape">
    <div class="wrap">
        <div class="rod-grid">
            <div class="rod-marca">
                <img src="~/img/logo.png" alt="Metisa, Metalúrgica Timboense S.A." width="132" height="92" />
                <p>Metalúrgica Timboense S.A.</p>
                <p id="seguir"><strong>Siga a Metisa</strong></p>
                <ul class="redes" aria-labelledby="seguir">
                    <li><a href="https://www.facebook.com/MetisaOficial/" target="_blank" rel="noopener noreferrer" aria-label="Metisa no Facebook (abre em nova aba)"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M13.5 21v-8h2.7l.4-3.2h-3.1V7.8c0-.9.3-1.5 1.6-1.5h1.7V3.4c-.3 0-1.3-.1-2.4-.1-2.4 0-4.1 1.5-4.1 4.2v2.3H7.5V13h2.8v8z" /></svg></a></li>
                    <li><a href="https://www.instagram.com/metisaoficial/" target="_blank" rel="noopener noreferrer" aria-label="Metisa no Instagram (abre em nova aba)"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3.5" y="3.5" width="17" height="17" rx="5" fill="none" stroke="currentColor" stroke-width="1.8" /><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8" /><circle cx="17.3" cy="6.7" r="1" fill="currentColor" /></svg></a></li>
                    <li><a href="https://www.linkedin.com/company/metisa" target="_blank" rel="noopener noreferrer" aria-label="Metisa no LinkedIn (abre em nova aba)"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><rect x="3.5" y="9" width="3.6" height="11.5" /><circle cx="5.3" cy="5.2" r="2.1" /><path d="M10 9h3.4v1.6c.6-1.1 1.9-1.9 3.7-1.9 3.4 0 4 2.2 4 5.1v6.7h-3.6v-5.9c0-1.4 0-3.1-1.9-3.1-1.9 0-2.2 1.5-2.2 3v6H10z" /></svg></a></li>
                </ul>
            </div>
            <div class="cols-un">
                @foreach (var u in Model.Unidades)
                {
                    <div>
                        <p><strong>@u.Nome</strong></p>
                        <p>@u.Endereco@(string.IsNullOrWhiteSpace(u.Bairro) ? "" : ", " + u.Bairro)</p>
                        <p>@u.Cidade (@u.Uf)</p>
                        @if (!string.IsNullOrWhiteSpace(u.Telefone)) { <p>@u.Telefone</p> }
                    </div>
                }
            </div>
        </div>
        @if (Model.Aviso)
        {
            <p class="nota">Ambiente de avaliação. Vagas, benefícios, programas e os textos marcados como exemplo são conteúdo de exemplo. Imagens e logo são da Metisa e estão aqui apenas para avaliação do layout.</p>
        }
    </div>
</footer>
