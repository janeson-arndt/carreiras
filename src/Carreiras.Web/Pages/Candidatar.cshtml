@page "/candidatar"
@model Carreiras.Web.Pages.CandidatarModel
@{
    var v = Model.Vaga;
    ViewData["Title"] = v == null ? "Vaga não encontrada" : "Candidatar-se: " + v.Titulo;
}
@section Head {
    <meta name="robots" content="noindex" />
    <script src="~/js/candidatar.js" asp-append-version="true" defer></script>
}

@if (v == null)
{
    <div class="wrap nao-encontrada">
        <h1>Vaga não encontrada</h1>
        <p>Esta vaga não existe ou já foi encerrada, então não dá para se candidatar. <a asp-page="/Vagas/Index">Veja as vagas abertas.</a></p>
    </div>
}
else
{
    <div class="faixa faixa-curta">
        <div class="wrap">
            <p class="migalha"><a asp-page="/Vagas/Detalhe" asp-route-slug="@v.Slug">&larr; Voltar para a vaga</a></p>
            <h1>Candidatar-se</h1>
            <p class="vaga-nome">@v.Titulo &middot; @v.UnidadeCidade (@v.UnidadeUf)</p>
        </div>
    </div>

    <partial name="_FormCandidatura" model="Model" />
}

