@page "/admin/conteudo"
@model Carreiras.Web.Areas.Admin.Pages.Conteudo.IndexModel
@{
    ViewData["Title"] = "Conteúdo do portal";
    ViewData["Menu"] = "conteudo";
    string Resumo(string t) => t.Length <= 140 ? t : t[..140].TrimEnd() + "…";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Conteúdo do portal</h1>
    @if (Model.PodeEditar)
    {
        <a class="btn btn-primary" asp-page="Editar">Novo conteúdo</a>
    }
</div>
<p class="text-secundario">Textos institucionais que aparecem no portal público. Só o que está publicado é exibido.</p>
@if (!Model.PodeEditar)
{
    <p class="text-secundario">Seu perfil só consulta os cadastros. Para alterar, peça a um administrador.</p>
}
@if (Model.Itens.Count == 0)
{
    <div class="cartao p-4 text-center">Nenhum conteúdo cadastrado.</div>
}
else
{
<div class="cartao">
    <div class="table-responsive" style="overflow: visible">
    <table class="table align-middle mb-0 tabela-cartoes" role="table">
        <caption class="visually-hidden">Conteúdos institucionais</caption>
        <thead><tr role="row"><th role="columnheader" scope="col">Conteúdo</th><th role="columnheader" scope="col">Seção</th><th role="columnheader" scope="col">Ordem</th><th role="columnheader" scope="col">Situação</th><th role="columnheader" scope="col" class="text-end">Ações</th></tr></thead>
        <tbody>
        @foreach (var c in Model.Itens)
        {
            <tr role="row">
                <td role="cell"><strong>@c.Titulo</strong>@if (c.Ficticio) { <span class="etiqueta exemplo ms-1">exemplo</span> }<br /><small class="text-secundario">@Resumo(c.Texto)</small></td>
                <td role="cell" data-rotulo="Seção"><code>@c.Secao</code></td>
                <td role="cell" data-rotulo="Ordem">@c.Ordem</td>
                <td role="cell" data-rotulo="Situação"><span class="etiqueta @(c.Publicado ? "" : "inativo")">@(c.Publicado ? "Publicado" : "Despublicado")</span></td>
                <td role="cell" class="text-end text-nowrap">
                    <a class="btn btn-sm btn-primary" asp-page="Editar" asp-route-id="@c.Id">@(Model.PodeEditar ? "Editar" : "Ver")</a>
                    @if (Model.PodeEditar)
                    {
                        <div class="acoes">
                            <button type="button" class="btn btn-sm btn-neutro" data-acoes aria-expanded="false" aria-controls="acoes-@c.Id">Ações</button>
                            <div class="acoes-lista text-start" id="acoes-@c.Id" hidden>
                                @if (c.Publicado)
                                {
                                    <form method="post" asp-page-handler="Publicar" asp-route-id="@c.Id" asp-route-publicado="false">
                                        <button type="submit" class="perigo" data-confirmar="Despublicar @c.Titulo? Ele sai do portal público.">Despublicar</button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="Publicar" asp-route-id="@c.Id" asp-route-publicado="true"><button type="submit">Publicar</button></form>
                                }
                            </div>
                        </div>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
</div>
}
