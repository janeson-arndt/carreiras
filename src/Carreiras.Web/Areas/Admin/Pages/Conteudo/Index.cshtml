@page "/admin/conteudo"
@model Carreiras.Web.Areas.Admin.Pages.Conteudo.IndexModel
@{
    ViewData["Title"] = "Conteúdo da vitrine";
    ViewData["Menu"] = "conteudo";
    string Resumo(string t) => t.Length <= 110 ? t : t[..110].TrimEnd() + "...";
}
<div class="topo-pagina">
    <div>
        <h1>Conteúdo da vitrine</h1>
        <p>Textos institucionais exibidos no portal público.</p>
    </div>
    @if (Model.PodeEditar)
    {
        <a class="btn btn-primary" asp-page="Editar">Novo conteúdo</a>
    }
</div>
@if (!Model.PodeEditar)
{
    <p class="somente">Os cadastros são mantidos pelo perfil Administrador. Você pode consultar, mas não alterar.</p>
}
@if (Model.Itens.Count == 0)
{
    <div class="cartao vazio"><p>Nenhum conteúdo cadastrado.</p></div>
}
else
{
<div class="cartao">
    <div class="table-responsive" tabindex="0" role="region" aria-label="Conteúdos da vitrine (use as setas para rolar a tabela)">
    <table class="table tabela-cartoes" role="table">
        <caption class="visually-hidden">Conteúdos institucionais</caption>
        <thead><tr role="row"><th role="columnheader" scope="col">Seção</th><th role="columnheader" scope="col">Texto</th><th role="columnheader" scope="col">No portal</th><th role="columnheader" scope="col">Ações</th></tr></thead>
        <tbody>
        @foreach (var c in Model.Itens)
        {
            <tr role="row">
                <td role="cell"><strong>@c.Titulo</strong><div class="ajuda">@c.Secao</div></td>
                <td role="cell" data-rotulo="Texto">@Resumo(c.Texto)</td>
                <td role="cell" data-rotulo="No portal">@(c.Publicado ? "Publicado" : "Oculto")</td>
                <td role="cell">
                    @if (Model.PodeEditar)
                    {
                        <div class="acoes-linha">
                            <a class="btn btn-sec btn-peq" asp-page="Editar" asp-route-id="@c.Id">Editar texto</a>
                            <div class="acoes">
                                <button type="button" class="btn btn-sec btn-peq" data-acoes aria-expanded="false" aria-controls="acoes-@c.Id" aria-label="Mais ações para @c.Titulo">Ações <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
                                <div class="acoes-lista" id="acoes-@c.Id" hidden>
                                    @if (c.Publicado)
                                    {
                                        <form method="post" asp-page-handler="Publicar" asp-route-id="@c.Id" asp-route-publicado="false">
                                            <button type="submit" class="perigo" data-confirmar="Despublicar @c.Titulo? Ele sai do portal público.">Despublicar</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form method="post" asp-page-handler="Publicar" asp-route-id="@c.Id" asp-route-publicado="true"><button type="submit">Publicar</button></form>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <a asp-page="Editar" asp-route-id="@c.Id" aria-label="Ver @c.Titulo">Ver</a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
</div>
}
