@page "/admin/vagas/editar/{id:int?}"
@model Carreiras.Web.Areas.Admin.Pages.Vagas.EditarModel
@using Carreiras.Dominio.Vagas
@{
    var titulo = Model.Nova ? "Nova vaga" : (string.IsNullOrWhiteSpace(Model.Form.Titulo) ? "Vaga" : Model.Form.Titulo);
    ViewData["Title"] = Model.Nova ? "Nova vaga" : "Editar vaga";
    ViewData["Menu"] = "vagas";
    var dis = Model.Bloqueada ? "disabled" : null;
    var statusAtual = Model.Nova ? StatusVaga.Rascunho : Model.Status;
}
<div class="topo-pagina">
    <div>
        <p><a asp-page="Index">Voltar para as vagas</a></p>
        <h1>@titulo</h1>
    </div>
</div>

@if (!Model.PodeGerenciar)
{
    <p class="somente">Seu perfil só consulta. Os campos estão bloqueados.</p>
}
else if (Model.Encerrada)
{
    <p class="somente">Vaga encerrada não pode ser editada nem reaberta. Para divulgar de novo, duplique a vaga na lista.</p>
}

@if (Model.Erros.Count > 0)
{
    <div class="aviso-erro resumo-erros" role="alert" tabindex="-1" id="resumo-erros">
        <strong>@(Model.ErroGeral ?? "Corrija os campos indicados.")</strong>
        <ul>
            @foreach (var e in Model.Erros) { <li><a href="#@(e.Key == "Listas" ? "Form_Titulo" : "Form_" + e.Key)">@e.Value</a></li> }
        </ul>
    </div>
}
else if (Model.ErroGeral != null)
{
    <p class="aviso-erro" role="alert">@Model.ErroGeral</p>
}

<form method="post" novalidate>
<fieldset @dis>
<div class="editor">
    <div>
        <div class="cartao bloco">
            <h2>Dados da vaga</h2>
            <div class="campo">
                <label class="form-label" for="Form_Titulo">Título</label>
                <input class="form-control" id="Form_Titulo" name="Form.Titulo" value="@Model.Form.Titulo" maxlength="150" required
                       aria-invalid="@Model.Invalido("Titulo")" aria-describedby="e-Titulo" />
                <div class="erro-campo" id="e-Titulo">@Model.Erro("Titulo")</div>
            </div>
            <div class="campo">
                <label class="form-label" for="Form_Descricao">Descrição</label>
                <textarea class="form-control" id="Form_Descricao" name="Form.Descricao" rows="4" required
                          aria-invalid="@Model.Invalido("Descricao")" aria-describedby="e-Descricao">@Model.Form.Descricao</textarea>
                <div class="erro-campo" id="e-Descricao">@Model.Erro("Descricao")</div>
            </div>
            <div class="grade3">
                <div class="campo">
                    <label class="form-label" for="Form_UnidadeId">Unidade</label>
                    <select class="form-select" id="Form_UnidadeId" name="Form.UnidadeId" aria-invalid="@Model.Invalido("UnidadeId")" aria-describedby="e-UnidadeId">
                        <option value="0">Escolha</option>
                        @foreach (var x in Model.Unidades) { <option value="@x.Id" selected="@(Model.Form.UnidadeId == x.Id)">@x.Nome</option> }
                    </select>
                    <div class="erro-campo" id="e-UnidadeId">@Model.Erro("UnidadeId")</div>
                </div>
                <div class="campo">
                    <label class="form-label" for="Form_AreaId">Área</label>
                    <select class="form-select" id="Form_AreaId" name="Form.AreaId" aria-invalid="@Model.Invalido("AreaId")" aria-describedby="e-AreaId">
                        <option value="0">Escolha</option>
                        @foreach (var x in Model.Areas) { <option value="@x.Id" selected="@(Model.Form.AreaId == x.Id)">@x.Nome</option> }
                    </select>
                    <div class="erro-campo" id="e-AreaId">@Model.Erro("AreaId")</div>
                </div>
                <div class="campo">
                    <label class="form-label" for="Form_TurnoId">Turno</label>
                    <select class="form-select" id="Form_TurnoId" name="Form.TurnoId" aria-invalid="@Model.Invalido("TurnoId")" aria-describedby="e-TurnoId">
                        <option value="0">Escolha</option>
                        @foreach (var x in Model.Turnos) { <option value="@x.Id" selected="@(Model.Form.TurnoId == x.Id)">@x.Nome</option> }
                    </select>
                    <div class="erro-campo" id="e-TurnoId">@Model.Erro("TurnoId")</div>
                </div>
            </div>
            <div class="grade3">
                <div class="campo">
                    <label class="form-label" for="Form_TipoContratoId">Tipo de contrato</label>
                    <select class="form-select" id="Form_TipoContratoId" name="Form.TipoContratoId" aria-invalid="@Model.Invalido("TipoContratoId")" aria-describedby="e-TipoContratoId">
                        <option value="0">Escolha</option>
                        @foreach (var x in Model.Contratos) { <option value="@x.Id" selected="@(Model.Form.TipoContratoId == x.Id)">@x.Nome</option> }
                    </select>
                    <div class="erro-campo" id="e-TipoContratoId">@Model.Erro("TipoContratoId")</div>
                </div>
                <div class="campo">
                    <label class="form-label" for="Form_ModalidadeId">Modalidade</label>
                    <select class="form-select" id="Form_ModalidadeId" name="Form.ModalidadeId" aria-invalid="@Model.Invalido("ModalidadeId")" aria-describedby="e-ModalidadeId">
                        <option value="0">Escolha</option>
                        @foreach (var x in Model.Modalidades) { <option value="@x.Id" selected="@(Model.Form.ModalidadeId == x.Id)">@x.Nome</option> }
                    </select>
                    <div class="erro-campo" id="e-ModalidadeId">@Model.Erro("ModalidadeId")</div>
                </div>
                <div class="campo">
                    <label class="form-label" for="Form_ProgramaId">Programa <span class="ajuda">(opcional)</span></label>
                    <select class="form-select" id="Form_ProgramaId" name="Form.ProgramaId">
                        <option value="">Nenhum</option>
                        @foreach (var x in Model.Programas) { <option value="@x.Id" selected="@(Model.Form.ProgramaId == x.Id)">@x.Nome</option> }
                    </select>
                </div>
            </div>
        </div>

        <div class="cartao bloco">
            <h2>Requisitos</h2>
            <div class="campo">
                <label class="form-label" for="RequisitosObrigatorios">Obrigatórios <span class="ajuda">(um por linha)</span></label>
                <textarea class="form-control" id="RequisitosObrigatorios" name="RequisitosObrigatorios" rows="3">@Model.RequisitosObrigatorios</textarea>
            </div>
            <div class="campo" style="margin-bottom: 0">
                <label class="form-label" for="RequisitosDesejaveis">Desejáveis <span class="ajuda">(um por linha)</span></label>
                <textarea class="form-control" id="RequisitosDesejaveis" name="RequisitosDesejaveis" rows="3">@Model.RequisitosDesejaveis</textarea>
            </div>
        </div>

        <div class="cartao bloco">
            <h2>O que a pessoa vai fazer</h2>
            <label class="visually-hidden" for="AtividadesTexto">Atividades, uma por linha</label>
            <textarea class="form-control" id="AtividadesTexto" name="AtividadesTexto" rows="3" aria-describedby="dica-atividades">@Model.AtividadesTexto</textarea>
            <p class="ajuda" id="dica-atividades">Uma atividade por linha.</p>
        </div>

        <div class="cartao bloco">
            <h2>Diferenciais</h2>
            <label class="visually-hidden" for="DiferenciaisTexto">Diferenciais, um por linha</label>
            <textarea class="form-control" id="DiferenciaisTexto" name="DiferenciaisTexto" rows="3" aria-describedby="dica-diferenciais">@Model.DiferenciaisTexto</textarea>
            <p class="ajuda" id="dica-diferenciais">Um diferencial por linha.</p>
        </div>

        <div class="cartao bloco">
            <h2>Benefícios da vaga</h2>
            @foreach (var c in Model.Categorias.Where(c => c.Beneficios.Count > 0))
            {
                <fieldset class="cat-ben">
                    <legend>@c.Nome</legend>
                    @foreach (var b in c.Beneficios)
                    {
                        <label class="check" for="ben-@b.Id"><input type="checkbox" id="ben-@b.Id" name="Form.BeneficioIds" value="@b.Id" checked="@Model.Form.BeneficioIds.Contains(b.Id)" /> @b.Nome</label>
                    }
                </fieldset>
            }
        </div>

        <div class="cartao bloco">
            <h2>Faixa salarial</h2>
            <div class="grade2">
                <div class="campo">
                    <label class="form-label" for="Form_SalarioMin">Mínimo (R$)</label>
                    <input class="form-control" id="Form_SalarioMin" name="Form.SalarioMin" inputmode="decimal" value="@Model.Form.SalarioMin" aria-invalid="@Model.Invalido("SalarioMin")" aria-describedby="e-SalarioMin" />
                    <div class="erro-campo" id="e-SalarioMin">@Model.Erro("SalarioMin")</div>
                </div>
                <div class="campo">
                    <label class="form-label" for="Form_SalarioMax">Máximo (R$)</label>
                    <input class="form-control" id="Form_SalarioMax" name="Form.SalarioMax" inputmode="decimal" value="@Model.Form.SalarioMax" />
                </div>
            </div>
            <label class="check" for="Form_ExibirSalario">
                <input type="checkbox" id="Form_ExibirSalario" name="Form.ExibirSalario" value="true" checked="@Model.Form.ExibirSalario" /> Mostrar a faixa salarial no portal público
            </label>
            <input type="hidden" name="Form.ExibirSalario" value="false" />
            <p class="ajuda">Por padrão a faixa fica oculta no portal público.</p>
        </div>
    </div>

    <aside class="lateral" aria-label="Publicação da vaga">
        <div class="cartao bloco">
            <h2>Publicação</h2>
            <dl>
                <dt>Status</dt>
                <dd><span class="selo s-@statusAtual">@EditarModel.RotuloStatus(statusAtual)</span></dd>
                <dt>Endereço no portal</dt>
                <dd>/vagas/@(Model.Resumo?.Slug ?? "(gerado ao salvar)")</dd>
                @if (Model.Resumo?.PublicadaEm != null)
                {
                    <dd class="ajuda">O endereço fica fixo depois da publicação, para os links não quebrarem.</dd>
                }
                <dt>Publicada em</dt>
                <dd>@(Model.Resumo?.PublicadaEm is DateTime p ? DateTime.SpecifyKind(p, DateTimeKind.Utc).ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "-")</dd>
            </dl>
            @if (!Model.Bloqueada)
            {
                <div class="acoes-col">
                    <button class="btn btn-primary" type="submit">@(Model.Nova ? "Salvar como rascunho" : "Salvar alterações")</button>
                    @foreach (var t in Model.Transicoes)
                    {
                        <button class="btn @(t == StatusVaga.Encerrada ? "btn-perigo" : "btn-sec")" type="submit" asp-page-handler="Transicao" asp-route-novo="@t"
                                data-confirmar="@(t == StatusVaga.Encerrada ? $"Encerrar a vaga? Ela não poderá ser reaberta; para voltar, duplique." : null)">@EditarModel.RotuloTransicao(statusAtual, t)</button>
                    }
                </div>
            }
            @if (Model.Resumo is { Historico.Count: > 0 })
            {
                <h3 style="margin-top: 16px">Histórico de status</h3>
                <ul class="hist">
                    @foreach (var h in Model.Resumo.Historico)
                    {
                        <li>@EditarModel.RotuloStatus(h.Status), @DateTime.SpecifyKind(h.AlteradoEm, DateTimeKind.Utc).ToLocalTime().ToString("dd/MM/yyyy HH:mm")@(string.IsNullOrEmpty(h.Usuario) ? "" : ", " + h.Usuario)</li>
                    }
                </ul>
            }
        </div>
    </aside>
</div>
</fieldset>
</form>
