@page "/admin/vagas"
@model Carreiras.Web.Areas.Admin.Pages.Vagas.IndexModel
@using Carreiras.Dominio.Vagas
@{
    ViewData["Title"] = "Vagas";
    ViewData["Menu"] = "vagas";
    string Rotulo(string s) => s switch { "RASCUNHO" => "Rascunho", "PUBLICADA" => "Publicada", "PAUSADA" => "Pausada", _ => "Encerrada" };
}
<div class="topo-pagina">
    <div>
        <h1>Vagas</h1>
        <p>Cadastre, publique e acompanhe as vagas do portal.</p>
    </div>
    @if (Model.PodeGerenciar)
    {
        <a class="btn btn-primary" asp-page="Editar">Nova vaga</a>
    }
</div>
@if (!Model.PodeGerenciar)
{
    <p class="somente">Seu perfil só consulta. Para criar ou alterar vagas, peça acesso de Analista.</p>
}

<form method="get" class="filtros" role="search">
    <div class="busca">
        <label class="form-label" for="busca">Buscar pelo título</label>
        <input class="form-control" id="busca" name="busca" value="@Model.Busca" />
    </div>
    <div>
        <label class="form-label" for="status">Status</label>
        <select class="form-select" id="status" name="status">
            <option value="">Todos</option>
            @foreach (var s in new[] { "RASCUNHO", "PUBLICADA", "PAUSADA", "ENCERRADA" })
            {
                <option value="@s" selected="@(Model.Status == s)">@Rotulo(s)</option>
            }
        </select>
    </div>
    <div>
        <label class="form-label" for="unidadeId">Unidade</label>
        <select class="form-select" id="unidadeId" name="unidadeId">
            <option value="">Todas</option>
            @foreach (var u in Model.Unidades)
            {
                <option value="@u.Id" selected="@(Model.UnidadeId == u.Id)">@u.Cidade</option>
            }
        </select>
    </div>
    <button class="btn btn-sec" type="submit">Filtrar</button>
</form>

@if (Model.Itens.Count == 0 && !Model.FiltroAtivo)
{
    <div class="cartao vazio">
        <p>Nenhuma vaga cadastrada ainda.</p>
        @if (Model.PodeGerenciar) { <a class="btn btn-primary" asp-page="Editar">Criar a primeira vaga</a> }
    </div>
}
else if (Model.Itens.Count == 0)
{
    <div class="cartao vazio">
        <p>Nenhuma vaga com esses filtros.</p>
        <a class="btn btn-sec" asp-page="Index">Limpar filtros</a>
    </div>
}
else
{
<p class="contagem" aria-live="polite">@Model.Itens.Count @(Model.Itens.Count == 1 ? "vaga" : "vagas")</p>
<div class="cartao">
    <div class="table-responsive" tabindex="0" role="region" aria-label="Vagas cadastradas (use as setas para rolar a tabela)">
    <table class="table tabela-cartoes" role="table">
        <caption class="visually-hidden">Vagas cadastradas</caption>
        <thead>
            <tr role="row"><th role="columnheader" scope="col">Vaga</th><th role="columnheader" scope="col">Unidade</th><th role="columnheader" scope="col">Turno</th><th role="columnheader" scope="col">Status</th><th role="columnheader" scope="col">Candidaturas</th><th role="columnheader" scope="col">Atualizada</th><th role="columnheader" scope="col">Ações</th></tr>
        </thead>
        <tbody>
        @foreach (var v in Model.Itens)
        {
            <tr role="row">
                <td role="cell"><a asp-page="Editar" asp-route-id="@v.Id"><strong>@v.Titulo</strong></a><div class="ajuda">/vagas/@v.Slug</div></td>
                <td role="cell" data-rotulo="Unidade">@v.Unidade</td>
                <td role="cell" data-rotulo="Turno">@v.Turno</td>
                <td role="cell" data-rotulo="Status"><span class="selo s-@v.Status">@Rotulo(v.Status)</span></td>
                <td role="cell" data-rotulo="Candidaturas">@v.Candidaturas</td>
                <td role="cell" data-rotulo="Atualizada">@v.AtualizadaEm.ToLocalTime().ToString("dd/MM/yyyy")</td>
                <td role="cell">
                    <div class="acoes-linha">
                        <a class="btn btn-sec btn-peq" asp-page="Editar" asp-route-id="@v.Id">@(Model.PodeGerenciar && v.Status != "ENCERRADA" ? "Editar" : "Ver")</a>
                        @if (Model.PodeGerenciar)
                        {
                            var destinos = StatusVaga.Destinos(v.Status);
                            <div class="acoes">
                                <button type="button" class="btn btn-sec btn-peq" data-acoes aria-expanded="false" aria-controls="acoes-@v.Id" aria-label="Mais ações para @v.Titulo">Ações <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
                                <div class="acoes-lista" id="acoes-@v.Id" hidden>
                                    @if (destinos.Contains(StatusVaga.Publicada))
                                    {
                                        <form method="post" asp-page-handler="Status" asp-route-id="@v.Id" asp-route-novo="PUBLICADA"><button type="submit">@(v.Status == "PAUSADA" ? "Reativar" : "Publicar")</button></form>
                                    }
                                    @if (destinos.Contains(StatusVaga.Pausada))
                                    {
                                        <form method="post" asp-page-handler="Status" asp-route-id="@v.Id" asp-route-novo="PAUSADA"><button type="submit">Pausar</button></form>
                                    }
                                    <form method="post" asp-page-handler="Duplicar" asp-route-id="@v.Id"><button type="submit">Duplicar</button></form>
                                    @if (destinos.Contains(StatusVaga.Encerrada))
                                    {
                                        <hr />
                                        <form method="post" asp-page-handler="Status" asp-route-id="@v.Id" asp-route-novo="ENCERRADA">
                                            <button type="submit" class="perigo" data-confirmar="Encerrar a vaga @v.Titulo? Ela não poderá ser reaberta; para voltar, duplique.">Encerrar</button>
                                        </form>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
</div>
}
