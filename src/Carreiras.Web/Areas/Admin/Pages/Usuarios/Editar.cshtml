@page "/admin/usuarios/{id:int}"
@model Carreiras.Web.Areas.Admin.Pages.Usuarios.EditarModel
@using Carreiras.Dominio.Usuarios
@{
    ViewData["Title"] = "Editar usuário";
    ViewData["Menu"] = "usuarios";
    var descricoes = new Dictionary<string, (string Rotulo, string Texto)>
    {
        [Perfis.Administrador] = ("Administrador", "Faz tudo: vagas, candidaturas, cadastros e auditoria."),
        [Perfis.Analista] = ("Analista", "Gerencia vagas e candidaturas; só consulta os cadastros."),
        [Perfis.Leitura] = ("Leitura", "Só consulta. Não altera nada."),
    };
}
<div class="topo-pagina">
    <div>
        <p><a asp-page="Index">Voltar para os usuários</a></p>
        <h1>Editar usuário</h1>
    </div>
</div>
@if (Model.Erro != null)
{
    <p class="aviso-erro" role="alert">@Model.Erro</p>
}
<form method="post">
    <div class="cartao bloco" style="max-width: 560px">
        <div class="campo">
            <label class="form-label" for="NomeUsuario">Nome</label>
            <input class="form-control" id="NomeUsuario" value="@Model.Usuario!.Nome" readonly />
        </div>
        <div class="campo">
            <label class="form-label" for="EmailUsuario">E-mail</label>
            <input class="form-control" id="EmailUsuario" type="email" value="@Model.Usuario.Email" readonly aria-describedby="dica-email" />
            <div class="ajuda" id="dica-email">Para trocar o e-mail, desative este usuário e cadastre um novo.</div>
        </div>
        <fieldset class="perfis" disabled="@Model.Proprio">
            <legend>Perfil de acesso</legend>
            @foreach (var p in Perfis.Todos)
            {
                <label><input type="radio" name="perfil" value="@p" checked="@(Model.Usuario.Perfil == p)" /><span><b>@descricoes[p].Rotulo</b>@descricoes[p].Texto</span></label>
            }
        </fieldset>
        @if (Model.Proprio)
        {
            <p class="ajuda" style="margin-top: 12px">Você não pode mudar o seu próprio perfil. Peça a outro administrador.</p>
        }
        <div class="rodape-form">
            <a class="btn btn-sec" asp-page="Index">@(Model.Proprio ? "Voltar" : "Cancelar")</a>
            @if (!Model.Proprio) { <button class="btn btn-primary" type="submit">Salvar usuário</button> }
        </div>
    </div>
</form>
