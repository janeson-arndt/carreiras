@page "/admin/usuarios/novo"
@model Carreiras.Web.Areas.Admin.Pages.Usuarios.NovoModel
@using Carreiras.Dominio.Usuarios
@{
    ViewData["Title"] = "Novo usuário";
    ViewData["Menu"] = "usuarios";
    var descricoes = new Dictionary<string, (string Rotulo, string Texto)>
    {
        [Perfis.Administrador] = ("Administrador", "Faz tudo: vagas, candidaturas, cadastros e auditoria."),
        [Perfis.Analista] = ("Analista", "Gerencia vagas e candidaturas; só consulta os cadastros."),
        [Perfis.Leitura] = ("Leitura", "Só consulta. Não altera nada."),
    };
}
<div class="topo-pagina">
    <div>
        <p><a asp-page="Index">Voltar para os usuários</a></p>
        <h1>Novo usuário</h1>
    </div>
</div>
@if (Model.Erro != null)
{
    <p class="aviso-erro" role="alert">@Model.Erro</p>
}
<form method="post" novalidate>
    <div class="cartao bloco" style="max-width: 560px">
        <div class="campo">
            <label class="form-label" for="Nome">Nome</label>
            <input class="form-control" id="Nome" name="Nome" value="@Model.Nome" maxlength="120" required />
        </div>
        <div class="campo">
            <label class="form-label" for="Email">E-mail</label>
            <input class="form-control" id="Email" name="Email" type="email" value="@Model.Email" maxlength="256" required />
        </div>
        <fieldset class="perfis">
            <legend>Perfil de acesso</legend>
            @foreach (var p in Perfis.Todos)
            {
                <label><input type="radio" name="Perfil" value="@p" checked="@(Model.Perfil == p)" /><span><b>@descricoes[p].Rotulo</b>@descricoes[p].Texto</span></label>
            }
        </fieldset>
        <p class="ajuda" style="margin-top: 12px">A pessoa recebe um e-mail com um link para criar a senha. O link expira e só pode ser usado uma vez. Você não vê nem define a senha.</p>
        <div class="rodape-form">
            <a class="btn btn-sec" asp-page="Index">Cancelar</a>
            <button class="btn btn-primary" type="submit">Enviar convite</button>
        </div>
    </div>
</form>
