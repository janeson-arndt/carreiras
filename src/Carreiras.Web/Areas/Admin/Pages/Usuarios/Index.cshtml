@page "/admin/usuarios"
@model Carreiras.Web.Areas.Admin.Pages.Usuarios.IndexModel
@using Carreiras.Infra.Usuarios
@{
    ViewData["Title"] = "Usuários";
    ViewData["Menu"] = "usuarios";
    string Rotulo(SituacaoUsuario s) => s switch { SituacaoUsuario.Ativo => "Ativo", SituacaoUsuario.ConvitePendente => "Convite pendente", _ => "Desativado" };
    string Classe(SituacaoUsuario s) => s switch { SituacaoUsuario.Ativo => "", SituacaoUsuario.ConvitePendente => "pendente", _ => "inativo" };
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Usuários</h1>
    <a class="btn btn-primary" asp-page="Novo">Novo usuário</a>
</div>

<form method="get" class="cartao p-3 mb-3 d-flex flex-wrap gap-2 align-items-end" role="search">
    <div>
        <label class="form-label mb-1" for="q">Buscar por nome ou e-mail</label>
        <input class="form-control" id="q" name="q" value="@Model.Q" />
    </div>
    <div>
        <label class="form-label mb-1" for="situacao">Situação</label>
        <select class="form-select" id="situacao" name="situacao">
            <option value="">Todas</option>
            <option value="ativo" selected="@(Model.Situacao == "ativo")">Ativo</option>
            <option value="pendente" selected="@(Model.Situacao == "pendente")">Convite pendente</option>
            <option value="desativado" selected="@(Model.Situacao == "desativado")">Desativado</option>
        </select>
    </div>
    <button class="btn btn-neutro" type="submit">Filtrar</button>
</form>

<p aria-live="polite" class="text-secundario">@Model.Itens.Count @(Model.Itens.Count == 1 ? "usuário" : "usuários")</p>

@if (Model.Itens.Count == 0)
{
    <div class="cartao p-4 text-center">
        <p class="mb-2">Nenhum usuário com esses filtros.</p>
        <a asp-page="Index">Limpar filtros</a>
    </div>
}
else
{
<div class="cartao">
    <div class="table-responsive" style="overflow: visible">
    <table class="table align-middle mb-0">
        <caption class="visually-hidden">Usuários do portal do RH</caption>
        <thead>
            <tr><th scope="col">Nome</th><th scope="col">Perfil</th><th scope="col">Situação</th><th scope="col">Último acesso</th><th scope="col" class="text-end">Ações</th></tr>
        </thead>
        <tbody>
        @foreach (var u in Model.Itens)
        {
            var proprio = u.Id == Model.AtorId;
            var motivo = Model.MotivoDesativar(u);
            <tr>
                <td><strong>@u.Nome</strong>@if (proprio) { <span class="text-secundario"> (você)</span> }<br /><small class="text-secundario">@u.Email</small></td>
                <td>@u.Perfil</td>
                <td><span class="etiqueta @Classe(u.Situacao)">@Rotulo(u.Situacao)</span></td>
                <td>@(u.UltimoAcessoEm.HasValue ? u.UltimoAcessoEm.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "Nunca entrou")</td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-primary" asp-page="Editar" asp-route-id="@u.Id">Editar</a>
                    <div class="acoes">
                        <button type="button" class="btn btn-sm btn-neutro" data-acoes aria-expanded="false" aria-controls="acoes-@u.Id">Ações</button>
                        <div class="acoes-lista text-start" id="acoes-@u.Id" hidden>
                            @if (u.Situacao == SituacaoUsuario.ConvitePendente)
                            {
                                <form method="post" asp-page-handler="ReenviarConvite" asp-route-id="@u.Id"><button type="submit">Reenviar convite</button></form>
                            }
                            @if (u.Ativo && u.ConviteAceito)
                            {
                                <form method="post" asp-page-handler="NovaSenha" asp-route-id="@u.Id"><button type="submit">Enviar link de nova senha</button></form>
                            }
                            @if (!u.Ativo)
                            {
                                <form method="post" asp-page-handler="Reativar" asp-route-id="@u.Id"><button type="submit">Reativar</button></form>
                            }
                            @if (u.Ativo)
                            {
                                <hr />
                                <form method="post" asp-page-handler="Desativar" asp-route-id="@u.Id">
                                    @if (motivo == null)
                                    {
                                        <button type="submit" class="perigo" data-confirmar="Desativar @u.Nome? A pessoa perde o acesso e as sessões abertas.">Desativar</button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="perigo" aria-disabled="true" aria-describedby="motivo-@u.Id">Desativar</button>
                                        <div class="motivo" id="motivo-@u.Id">@motivo</div>
                                    }
                                </form>
                            }
                        </div>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
</div>
}
