@page "/admin/usuarios"
@model Carreiras.Web.Areas.Admin.Pages.Usuarios.IndexModel
@using Carreiras.Infra.Usuarios
@{
    ViewData["Title"] = "Usuários";
    ViewData["Menu"] = "usuarios";
    string Rotulo(SituacaoUsuario s) => s switch { SituacaoUsuario.Ativo => "Ativo", SituacaoUsuario.ConvitePendente => "Convite pendente", _ => "Desativado" };
    // mesmos selos do protótipo: Ativo = verde, Convite pendente = âmbar, Desativado = cinza escuro
    string Selo(SituacaoUsuario s) => s switch { SituacaoUsuario.Ativo => "s-PUBLICADA", SituacaoUsuario.ConvitePendente => "s-PAUSADA", _ => "s-ENCERRADA" };
    string Perfil(string p) => p.Length == 0 ? "" : char.ToUpperInvariant(p[0]) + p[1..].ToLowerInvariant();
}
<div class="topo-pagina">
    <div>
        <h1>Usuários</h1>
        <p>Quem pode entrar no portal do RH e com qual perfil.</p>
    </div>
    <a class="btn btn-primary" asp-page="Novo">Novo usuário</a>
</div>
<p class="ajuda" style="margin: 0 0 12px">Usuários não são excluídos. Ao desativar, a pessoa perde o acesso e o histórico dela continua nos registros.</p>

<form method="get" class="filtros" role="search">
    <div class="busca">
        <label class="form-label" for="q">Buscar por nome ou e-mail</label>
        <input class="form-control" id="q" name="q" value="@Model.Q" />
    </div>
    <div>
        <label class="form-label" for="situacao">Situação</label>
        <select class="form-select" id="situacao" name="situacao">
            <option value="">Todas</option>
            <option value="ativo" selected="@(Model.Situacao == "ativo")">Ativo</option>
            <option value="pendente" selected="@(Model.Situacao == "pendente")">Convite pendente</option>
            <option value="desativado" selected="@(Model.Situacao == "desativado")">Desativado</option>
        </select>
    </div>
    <button class="btn btn-sec" type="submit">Filtrar</button>
</form>

@if (Model.Itens.Count == 0)
{
    <div class="cartao vazio">
        <p>Nenhum usuário com esses filtros.</p>
        <a class="btn btn-sec" asp-page="Index">Limpar filtros</a>
    </div>
}
else
{
<p class="contagem" aria-live="polite">@Model.Itens.Count @(Model.Itens.Count == 1 ? "usuário" : "usuários")</p>
<div class="cartao">
    <div class="table-responsive" tabindex="0" role="region" aria-label="Usuários do portal do RH (use as setas para rolar a tabela)">
    <table class="table tabela-cartoes" role="table">
        <caption class="visually-hidden">Usuários do portal do RH</caption>
        <thead>
            <tr role="row"><th role="columnheader" scope="col">Usuário</th><th role="columnheader" scope="col">Perfil</th><th role="columnheader" scope="col">Situação</th><th role="columnheader" scope="col">Último acesso</th><th role="columnheader" scope="col">Ações</th></tr>
        </thead>
        <tbody>
        @foreach (var u in Model.Itens)
        {
            var proprio = u.Id == Model.AtorId;
            var motivo = Model.MotivoDesativar(u);
            <tr role="row">
                <td role="cell"><strong>@u.Nome</strong>@if (proprio) { <span class="ex">você</span> }<div class="ajuda">@u.Email</div></td>
                <td role="cell" data-rotulo="Perfil">@Perfil(u.Perfil)</td>
                <td role="cell" data-rotulo="Situação"><span class="selo @Selo(u.Situacao)">@Rotulo(u.Situacao)</span></td>
                <td role="cell" data-rotulo="Último acesso">@(u.UltimoAcessoEm.HasValue ? u.UltimoAcessoEm.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "Nunca entrou")</td>
                <td role="cell">
                    <div class="acoes-linha">
                        <a class="btn btn-sec btn-peq" asp-page="Editar" asp-route-id="@u.Id">Editar</a>
                        <div class="acoes">
                            <button type="button" class="btn btn-sec btn-peq" data-acoes aria-expanded="false" aria-controls="acoes-@u.Id" aria-label="Mais ações para @u.Nome">Ações <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
                            <div class="acoes-lista" id="acoes-@u.Id" hidden>
                                @if (u.Situacao == SituacaoUsuario.ConvitePendente)
                                {
                                    <form method="post" asp-page-handler="ReenviarConvite" asp-route-id="@u.Id"><button type="submit">Reenviar convite</button></form>
                                }
                                @if (u.Ativo && u.ConviteAceito)
                                {
                                    <form method="post" asp-page-handler="NovaSenha" asp-route-id="@u.Id"><button type="submit">Enviar link de nova senha</button></form>
                                }
                                @if (!u.Ativo)
                                {
                                    <form method="post" asp-page-handler="Reativar" asp-route-id="@u.Id"><button type="submit">Reativar</button></form>
                                }
                                @if (u.Ativo)
                                {
                                    <hr />
                                    <form method="post" asp-page-handler="Desativar" asp-route-id="@u.Id">
                                        @if (motivo == null)
                                        {
                                            <button type="submit" class="perigo" data-confirmar="Desativar @u.Nome? A pessoa perde o acesso e as sessões abertas.">Desativar</button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="perigo" aria-disabled="true" aria-describedby="motivo-@u.Id">Desativar</button>
                                            <div class="motivo" id="motivo-@u.Id">@motivo</div>
                                        }
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
</div>
}
