@page "/admin/programas"
@model Carreiras.Web.Areas.Admin.Pages.Programas.IndexModel
@{
    ViewData["Title"] = "Programas";
    ViewData["Menu"] = "programas";
}
<div class="topo-pagina">
    <div>
        <h1>Programas</h1>
        <p>Estágio, aprendiz e trainee. Uma vaga pode pertencer a um programa.</p>
    </div>
    @if (Model.PodeEditar)
    {
        <a class="btn btn-primary" asp-page="Editar">Novo programa</a>
    }
</div>
@if (!Model.PodeEditar)
{
    <p class="somente">Os cadastros são mantidos pelo perfil Administrador. Você pode consultar, mas não alterar.</p>
}
@if (Model.Itens.Count == 0)
{
    <div class="cartao vazio"><p>Nenhum programa cadastrado.</p></div>
}
else
{
<div class="cartao">
    <div class="table-responsive" tabindex="0" role="region" aria-label="Programas (use as setas para rolar a tabela)">
    <table class="table tabela-cartoes" role="table">
        <caption class="visually-hidden">Programas</caption>
        <thead><tr role="row"><th role="columnheader" scope="col">Programa</th><th role="columnheader" scope="col">Descrição</th><th role="columnheader" scope="col">Público</th><th role="columnheader" scope="col">Situação</th><th role="columnheader" scope="col">Ações</th></tr></thead>
        <tbody>
        @foreach (var p in Model.Itens)
        {
            <tr role="row">
                <td role="cell"><strong>@p.Nome</strong></td>
                <td role="cell" data-rotulo="Descrição">@p.Descricao</td>
                <td role="cell" data-rotulo="Público">@p.PublicoAlvo</td>
                <td role="cell" data-rotulo="Situação">@(p.Ativo ? "Ativo" : "Inativo")</td>
                <td role="cell">
                    @if (Model.PodeEditar)
                    {
                        <div class="acoes-linha">
                            <a class="btn btn-sec btn-peq" asp-page="Editar" asp-route-id="@p.Id">Editar</a>
                            <div class="acoes">
                                <button type="button" class="btn btn-sec btn-peq" data-acoes aria-expanded="false" aria-controls="acoes-@p.Id" aria-label="Mais ações para @p.Nome">Ações <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
                                <div class="acoes-lista" id="acoes-@p.Id" hidden>
                                    @if (p.Ativo)
                                    {
                                        <form method="post" asp-page-handler="Alternar" asp-route-id="@p.Id" asp-route-ativo="false">
                                            <button type="submit" class="perigo" data-confirmar="Desativar @p.Nome? Ele deixa de aparecer para novas vagas.">Desativar</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form method="post" asp-page-handler="Alternar" asp-route-id="@p.Id" asp-route-ativo="true"><button type="submit">Reativar</button></form>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <a asp-page="Editar" asp-route-id="@p.Id" aria-label="Ver @p.Nome">Ver</a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
</div>
}
