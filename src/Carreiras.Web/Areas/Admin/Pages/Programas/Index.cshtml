@page "/admin/programas"
@model Carreiras.Web.Areas.Admin.Pages.Programas.IndexModel
@{
    ViewData["Title"] = "Programas";
    ViewData["Menu"] = "programas";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Programas</h1>
    @if (Model.PodeEditar)
    {
        <a class="btn btn-primary" asp-page="Editar">Novo programa</a>
    }
</div>
@if (!Model.PodeEditar)
{
    <p class="text-secundario">Seu perfil só consulta os cadastros. Para alterar, peça a um administrador.</p>
}
@if (Model.Itens.Count == 0)
{
    <div class="cartao p-4 text-center">Nenhum programa cadastrado.</div>
}
else
{
<div class="cartao">
    <div class="table-responsive" style="overflow: visible">
    <table class="table align-middle mb-0">
        <caption class="visually-hidden">Programas</caption>
        <thead><tr><th scope="col">Programa</th><th scope="col">Público-alvo</th><th scope="col">Situação</th><th scope="col" class="text-end">Ações</th></tr></thead>
        <tbody>
        @foreach (var p in Model.Itens)
        {
            <tr>
                <td><strong>@p.Nome</strong>@if (p.Ficticio) { <span class="etiqueta exemplo ms-1">exemplo</span> }<br /><small class="text-secundario">@p.Descricao</small></td>
                <td>@p.PublicoAlvo</td>
                <td><span class="etiqueta @(p.Ativo ? "" : "inativo")">@(p.Ativo ? "Ativo" : "Desativado")</span></td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-primary" asp-page="Editar" asp-route-id="@p.Id">@(Model.PodeEditar ? "Editar" : "Ver")</a>
                    @if (Model.PodeEditar)
                    {
                        <div class="acoes">
                            <button type="button" class="btn btn-sm btn-neutro" data-acoes aria-expanded="false" aria-controls="acoes-@p.Id">Ações</button>
                            <div class="acoes-lista text-start" id="acoes-@p.Id" hidden>
                                @if (p.Ativo)
                                {
                                    <form method="post" asp-page-handler="Alternar" asp-route-id="@p.Id" asp-route-ativo="false">
                                        <button type="submit" class="perigo" data-confirmar="Desativar @p.Nome? Ele deixa de aparecer para novas vagas.">Desativar</button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="Alternar" asp-route-id="@p.Id" asp-route-ativo="true"><button type="submit">Reativar</button></form>
                                }
                            </div>
                        </div>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
    </div>
</div>
}
