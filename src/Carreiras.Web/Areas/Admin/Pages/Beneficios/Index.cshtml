@page "/admin/beneficios"
@model Carreiras.Web.Areas.Admin.Pages.Beneficios.IndexModel
@{
    ViewData["Title"] = "Benefícios";
    ViewData["Menu"] = "beneficios";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Benefícios</h1>
    @if (Model.PodeEditar)
    {
        <a class="btn btn-primary" asp-page="Editar">Novo benefício</a>
    }
</div>
@if (!Model.PodeEditar)
{
    <p class="text-secundario">Seu perfil só consulta os cadastros. Para alterar, peça a um administrador.</p>
}
@foreach (var c in Model.Categorias)
{
    <section class="cartao mb-3" aria-labelledby="cat-@c.Id">
        <h2 class="h5 p-3 pb-0" id="cat-@c.Id">@c.Nome</h2>
        <div class="table-responsive" style="overflow: visible">
        <table class="table align-middle mb-0 tabela-cartoes" role="table">
            <caption class="visually-hidden">Benefícios da categoria @c.Nome</caption>
            <thead><tr role="row"><th role="columnheader" scope="col">Benefício</th><th role="columnheader" scope="col">Ícone</th><th role="columnheader" scope="col">Ordem</th><th role="columnheader" scope="col">Situação</th><th role="columnheader" scope="col" class="text-end">Ações</th></tr></thead>
            <tbody>
            @foreach (var b in c.Beneficios.OrderBy(x => x.Ordem).ThenBy(x => x.Nome))
            {
                <tr role="row">
                    <td role="cell"><strong>@b.Nome</strong>@if (b.Ficticio) { <span class="etiqueta exemplo ms-1">exemplo</span> }<br /><small class="text-secundario">@b.DescricaoCurta</small></td>
                    <td role="cell" data-rotulo="Ícone"><code>@b.Icone</code></td>
                    <td role="cell" data-rotulo="Ordem">@b.Ordem</td>
                    <td role="cell" data-rotulo="Situação"><span class="etiqueta @(b.Ativo ? "" : "inativo")">@(b.Ativo ? "Ativo" : "Desativado")</span></td>
                    <td role="cell" class="text-end text-nowrap">
                        <a class="btn btn-sm btn-primary" asp-page="Editar" asp-route-id="@b.Id">@(Model.PodeEditar ? "Editar" : "Ver")</a>
                        @if (Model.PodeEditar)
                        {
                            <div class="acoes">
                                <button type="button" class="btn btn-sm btn-neutro" data-acoes aria-expanded="false" aria-controls="acoes-@b.Id">Ações</button>
                                <div class="acoes-lista text-start" id="acoes-@b.Id" hidden>
                                    @if (b.Ativo)
                                    {
                                        <form method="post" asp-page-handler="Alternar" asp-route-id="@b.Id" asp-route-ativo="false">
                                            <button type="submit" class="perigo" data-confirmar="Desativar @b.Nome? Ele deixa de aparecer para novas vagas.">Desativar</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form method="post" asp-page-handler="Alternar" asp-route-id="@b.Id" asp-route-ativo="true"><button type="submit">Reativar</button></form>
                                    }
                                </div>
                            </div>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
        </div>
    </section>
}
