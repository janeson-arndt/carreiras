@page "/admin/beneficios/editar/{id:int?}"
@model Carreiras.Web.Areas.Admin.Pages.Beneficios.EditarModel
@{
    ViewData["Title"] = Model.Form.Id is null ? "Novo benefício" : "Editar benefício";
    ViewData["Menu"] = "beneficios";
    var dis = Model.PodeEditar ? null : "disabled";
}
<div class="topo-pagina">
    <div>
        <p><a asp-page="Index">Voltar para os benefícios</a></p>
        <h1>@ViewData["Title"]</h1>
    </div>
</div>
@if (!Model.PodeEditar) { <p class="somente">Os cadastros são mantidos pelo perfil Administrador. Você pode consultar, mas não alterar.</p> }
@if (Model.Erros.Count > 0)
{
    <div class="aviso-erro resumo-erros" role="alert">
        <strong>Corrija os campos indicados.</strong>
        <ul>@foreach (var e in Model.Erros) { <li><a href="#Form_@e.Key">@e.Value</a></li> }</ul>
    </div>
}
<form method="post" novalidate>
    <fieldset @dis class="cartao bloco" style="max-width: 560px">
        <div class="campo">
            <label class="form-label" for="Form_CategoriaId">Categoria</label>
            <select class="form-select" id="Form_CategoriaId" name="Form.CategoriaId" aria-invalid="@Model.Invalido("CategoriaId")" aria-describedby="e-CategoriaId">
                <option value="0">Escolha</option>
                @foreach (var c in Model.Categorias) { <option value="@c.Id" selected="@(Model.Form.CategoriaId == c.Id)">@c.Nome</option> }
            </select>
            <div class="erro-campo" id="e-CategoriaId">@Model.Erro("CategoriaId")</div>
        </div>
        <div class="campo">
            <label class="form-label" for="Form_Nome">Nome</label>
            <input class="form-control" id="Form_Nome" name="Form.Nome" value="@Model.Form.Nome" maxlength="80" required aria-invalid="@Model.Invalido("Nome")" aria-describedby="e-Nome" />
            <div class="erro-campo" id="e-Nome">@Model.Erro("Nome")</div>
        </div>
        <div class="campo">
            <label class="form-label" for="Form_DescricaoCurta">Frase curta do cartão <span class="ajuda">(até 160 caracteres)</span></label>
            <input class="form-control" id="Form_DescricaoCurta" name="Form.DescricaoCurta" value="@Model.Form.DescricaoCurta" maxlength="160" aria-invalid="@Model.Invalido("DescricaoCurta")" aria-describedby="e-DescricaoCurta" />
            <div class="erro-campo" id="e-DescricaoCurta">@Model.Erro("DescricaoCurta")</div>
        </div>
        <div class="grade2">
            <div class="campo">
                <label class="form-label" for="Form_Icone">Ícone</label>
                <input class="form-control" id="Form_Icone" name="Form.Icone" value="@Model.Form.Icone" maxlength="50" placeholder="bi-credit-card" aria-invalid="@Model.Invalido("Icone")" aria-describedby="e-Icone dica-icone" />
                <div class="ajuda" id="dica-icone">Nome do ícone na biblioteca Bootstrap Icons.</div>
                <div class="erro-campo" id="e-Icone">@Model.Erro("Icone")</div>
            </div>
            <div class="campo">
                <label class="form-label" for="Form_Ordem">Ordem na categoria</label>
                <input class="form-control" id="Form_Ordem" name="Form.Ordem" type="number" min="0" max="9999" value="@Model.Form.Ordem" aria-invalid="@Model.Invalido("Ordem")" aria-describedby="e-Ordem" />
                <div class="erro-campo" id="e-Ordem">@Model.Erro("Ordem")</div>
            </div>
        </div>
        @if (Model.PodeEditar)
        {
            <div class="rodape-form">
                <a class="btn btn-sec" asp-page="Index">Cancelar</a>
                <button class="btn btn-primary" type="submit">Salvar benefício</button>
            </div>
        }
    </fieldset>
    @if (!Model.PodeEditar) { <a class="btn btn-sec" asp-page="Index">Voltar à lista</a> }
</form>
